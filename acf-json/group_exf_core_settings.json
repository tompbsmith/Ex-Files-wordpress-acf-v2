            "instructions": "",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "message": "Payments go through Stripe Checkout. In your Stripe dashboard (Developers → Webhooks) add an endpoint at {webhook_url} for these events: <code>checkout.session.completed</code>, <code>checkout.session.async_payment_succeeded</code>, <code>checkout.session.expired</code>, <code>charge.refunded</code>. Then paste its signing secret below. On the live site it's safer to put the keys in wp-config.php instead (EXF_STRIPE_SECRET_KEY and EXF_STRIPE_WEBHOOK_SECRET), which overrides these fields.",
            "new_lines": "wpautop",
            "esc_html": 0
        },
